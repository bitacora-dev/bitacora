# Copy to /etc/bitacora/agent.env and replace the values before starting the agent.
BITACORA_HUB_URL=https://bitacora.example
BITACORA_TOKEN_FILE=/etc/bitacora/token

# Declare this host as reachable from the internet. Only then does the
# public-surface collector run (failed SSH logins, fail2ban jails and bans,
# active firewall rules, OVH traffic quota) and only then does the dashboard's
# public surface panel have anything to show. Leave it unset on hosts that are
# not exposed: the panel will say so rather than reporting a misleading zero.
#
# Reading failed SSH logins additionally requires the agent to be able to read
# the auth log. On Debian/Ubuntu /var/log/auth.log is root:adm 0640, and
# provision-user.sh only adds the bitacora user to systemd-journal, so that one
# signal stays unavailable until the operator grants read access. The other four
# signals do not depend on it.
# BITACORA_PUBLIC_EXPOSED=1
