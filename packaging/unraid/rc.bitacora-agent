#!/bin/sh

PLUGIN_DIR="/boot/config/plugins/bitacora-agent"
PID_FILE="/var/run/bitacora-agent.pid"
LOG_FILE="/var/log/bitacora-agent.log"
AGENT="$PLUGIN_DIR/bitacora-agent"

start() {
  if [ ! -x "$AGENT" ]; then
    echo "bitacora-agent binary not found at $AGENT" >&2
    exit 1
  fi
  if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
    echo "bitacora-agent already running"
    return 0
  fi
  mkdir -p /var/lib/bitacora
  BITACORA_UNRAID=1 "$AGENT" >>"$LOG_FILE" 2>&1 &
  echo $! >"$PID_FILE"
  echo "started bitacora-agent"
}

stop() {
  if [ ! -f "$PID_FILE" ]; then
    echo "bitacora-agent not running"
    return 0
  fi
  pid="$(cat "$PID_FILE")"
  if kill "$pid" 2>/dev/null; then
    rm -f "$PID_FILE"
    echo "stopped bitacora-agent"
  fi
}

status() {
  if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
    echo "bitacora-agent running"
    return 0
  fi
  echo "bitacora-agent stopped"
  return 1
}

case "$1" in
  start) start ;;
  stop) stop ;;
  restart) stop; start ;;
  status) status ;;
  *) echo "usage: $0 {start|stop|restart|status}" >&2; exit 2 ;;
esac
